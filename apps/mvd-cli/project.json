{
  "name": "mvd-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mvd-cli",
  "tags": [
    "type:go-app"
  ],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "outputs": [
        "{workspaceRoot}/dist/apps/mvd-cli"
      ],
      "options": {
        "outputPath": "../../dist/apps/mvd-cli/mvd-cli"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint",
      "parallelism": false,
      "options": {
        "linter": "golangci-lint",
        "args": [
          "run"
        ]
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/drop/go-app-mvd-cli.zip"
      ],
      "options": {
        "command": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/drop',{recursive:true});const A=require('adm-zip');const z=new A();z.addLocalFolder('dist/apps/mvd-cli');z.writeZip('dist/drop/go-app-mvd-cli.zip')\""
      }
    },
    "build-all": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/go.mod",
        "{workspaceRoot}/go.sum",
        {
          "env": "VERSION"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/platforms/mvd-cli"
      ],
      "options": {
        "command": "node -e \"const{spawnSync}=require('node:child_process');const v=process.env.VERSION||'dev';for(const p of ['windows/amd64','windows/arm64','linux/amd64','linux/arm64','darwin/amd64','darwin/arm64']){const[os,arch]=p.split('/');const out='../../dist/platforms/mvd-cli/'+os+'-'+arch+'/mvd-cli'+(os==='windows'?'.exe':'');const r=spawnSync('go',['build','-trimpath','-ldflags','-s -w -X main.version='+v,'-o',out,'.'],{cwd:'apps/mvd-cli',stdio:'inherit',env:{...process.env,CGO_ENABLED:'0',GOOS:os,GOARCH:arch}});if(r.status!==0)process.exit(r.status??1)}\""
      }
    },
    "package-all": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-all"
      ],
      "outputs": [
        "{workspaceRoot}/dist/drop/go-app-mvd-cli-*.zip"
      ],
      "options": {
        "command": "node -e \"const fs=require('node:fs');const A=require('adm-zip');fs.mkdirSync('dist/drop',{recursive:true});for(const d of fs.readdirSync('dist/platforms/mvd-cli')){const z=new A();z.addLocalFolder('dist/platforms/mvd-cli/'+d);z.writeZip('dist/drop/go-app-mvd-cli-'+d+'.zip')}\""
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "go run .",
        "cwd": "apps/mvd-cli"
      }
    }
  }
}
