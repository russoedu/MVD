{
  "folders": [
    {
      "path": ".",
      "name": "mvd"
    }
  ],
  "settings": {
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "json",
      "jsonc",
      "yaml",
      "markdown",
      "css",
      "html",
      "toml"
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true,
    "[javascript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[json]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[yaml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[markdown]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[css]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[html]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[toml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "nrwl.angular-console",
      "firsttris.vscode-jest-runner"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "mvd-tui: qa",
        "type": "npm",
        "script": "mvd-tui:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "mvd-tui: build",
        "type": "npm",
        "script": "mvd-tui:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "mvd-tui: start",
        "type": "npm",
        "script": "mvd-tui:start",
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "mvd-core: qa",
        "type": "npm",
        "script": "mvd-core:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "mvd-server: qa",
        "type": "npm",
        "script": "mvd-server:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "mvd-web: qa",
        "type": "npm",
        "script": "mvd-web:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "mvd-web: build",
        "type": "npm",
        "script": "mvd-web:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "mvd-web: start",
        "type": "npm",
        "script": "mvd-web:start",
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "mvd: qa",
        "type": "npm",
        "script": "mvd:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "mvd: build",
        "type": "npm",
        "script": "mvd:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "mvd: start",
        "type": "npm",
        "script": "mvd:start",
        "problemMatcher": [],
        "isBackground": true
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: build",
        "command": "npm run build",
        "cwd": "${workspaceFolder:mvd}",
        "presentation": {
          "group": "mnci",
          "order": 1
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: test",
        "command": "npm run test",
        "cwd": "${workspaceFolder:mvd}",
        "presentation": {
          "group": "mnci",
          "order": 2
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: lint",
        "command": "npm run lint",
        "cwd": "${workspaceFolder:mvd}",
        "presentation": {
          "group": "mnci",
          "order": 3
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: typecheck",
        "command": "npm run typecheck",
        "cwd": "${workspaceFolder:mvd}",
        "presentation": {
          "group": "mnci",
          "order": 4
        }
      }
    ]
  }
}
