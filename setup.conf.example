# setup.conf - Configuration file for yt-dlp playlist downloader

# Directory where downloaded videos will be saved
output_dir=../DJ/new

# Quality setting for yt-dlp (-f option)
# bestvideo+bestaudio/best downloads the highest quality video and audio streams available
quality=bestvideo+bestaudio/best

# Container format to merge video and audio streams into (e.g. mp4, mkv)
merge_output_format=mp4

# Output template for filenames inside output_dir
output_template=%(title)s.%(ext)s
# output_template=%(playlist_title,playlist)s/%(playlist_index)02d - %(title)s.%(ext)s

# Number of videos to download in parallel across all playlists (default 4)
max_concurrent_downloads=4

# How many fragments of a single video yt-dlp fetches in parallel
# (--concurrent-fragments). This is the main per-video speedup. "off" disables.
concurrent_fragments=4

# Retry failed downloads automatically (default on). One-off glitches are
# retried at once; rate-limited ones (429, bot checks) are retried in a sweep
# after the whole backlog finishes; private/removed videos are never retried.
# Set to "off" to fail and move on, like before.
auto_retry=on

# Download the official music video instead of the auto-generated audio track.
# Playlists often contain "<Artist> - Topic" uploads (the ones whose description
# ends with "Auto-generated by YouTube"). When this is true, the app crawls the
# description of each of those entries, follows the "Music" card link to the
# official video and downloads that instead. Entries from normal channels and
# tracks without an official video are downloaded unchanged.
download_official_music_video=false

# Browser cookies clear "Sign in to confirm you're not a bot" and HTTP 429.
# Leave this empty (or "all") and the app tries every installed browser and
# uses the first with a live YouTube login - no setup needed. Pin one browser
# by name (edge, chrome, firefox, brave, chromium, opera, vivaldi, or yt-dlp
# syntax like "firefox:default"). "off" disables cookies entirely.
# Note: Chrome/Edge 127+ encrypt cookies and often cannot be read; Firefox is
# the reliable source.
cookies_from_browser=

# Netscape cookie file. In auto mode the chosen browser's cookies are written
# here once and reused on later runs (delete it to refresh). You can also drop
# your own exported cookie file here. "off" disables.
cookies_file=cookies.txt

# File that receives every line of output (the screen only shows the tail).
# Set to "off" to disable.
log_file=mvd.log

# Extra flags to pass to yt-dlp (space separated)
# -4 enforces IPv4 (prevents YouTube 403 Forbidden errors on IPv6 connections)
# --js-runtimes node enables Node.js as the JavaScript runtime for signature decryption
extra_args=-4 --js-runtimes node
